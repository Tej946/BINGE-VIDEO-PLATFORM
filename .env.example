# ==============================================
# Server Configuration
# ==============================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ==============================================
# Database Configuration
# ==============================================
# Example for PostgreSQL:
DATABASE_URL=postgresql://postgres:password@localhost:5432/videoplatform
# Example for MongoDB:
# MONGODB_URI=mongodb://localhost:27017/videoplatform
# Example for SQLite:
# SQLITE_PATH=./database/video_platform.db

# ==============================================
# Authentication & Security
# ==============================================
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_change_in_production
REFRESH_TOKEN_EXPIRES_IN=30d

# ==============================================
# Uploads & Media Storage
# ==============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500
ALLOWED_MIME_TYPES=video/mp4,video/mkv,video/webm,video/quicktime

# Storage Provider: "local" or "s3" or "cloudinary"
STORAGE_PROVIDER=local

# AWS S3 / Cloudflare R2 (Optional if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# ==============================================
# Video Processing & Transcoding (FFmpeg)
# ==============================================
FFMPEG_PATH=
FFPROBE_PATH=

# ==============================================
# External Video Catalog (Optional)
# ==============================================
# When YOUTUBE_API_KEY is unset or empty, the external catalog safely degrades
# and BINGE runs in privacy-preserving local-only search mode.
EXTERNAL_CATALOG_ENABLED=true
YOUTUBE_API_KEY=
EXTERNAL_PROVIDER_TYPE=youtube
